ktor {
    development = true
    deployment {
        port = 8080 // Port on which the server will run
        watch = [development, application.conf] // Files to watch for automatic reload in development mode
    }
    application {
        modules = [org.openmbee.flexo.mms.ApplicationKt.module] // The module function from the Kotlin file
    }
}

jwt {
    domain = "http://flexo-mms-services"
    domain = ${?JWT_DOMAIN}
    audience = "flexo-mms-audience"
    audience = ${?JWT_AUDIENCE}
    secret = "thisissomethingreallylong1234567801234567890"
    secret = ${?JWT_SECRET}
    realm = "flexo-mms"
    realm = ${?JWT_REALM}
}

s3 {
    region = "us-gov-west-1"
    region = ${?S3_REGION}
    bucket = "load"
    bucket = ${?S3_BUCKET}
    endpoint = ""
    endpoint = ${?S3_ENDPOINT}
    access_key = "admintest"
    access_key = ${?AWS_ACCESS_KEY_ID}
    secret_key = "admintest"
    secret_key = ${?AWS_SECRET_ACCESS_KEY}
}
